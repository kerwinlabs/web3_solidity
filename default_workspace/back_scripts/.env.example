# 复制为 .env 后再修改
# 节点 RPC 地址：anvil 默认 http://127.0.0.1:8545，Sepolia 换成自己的 RPC
RPC_URL=http://127.0.0.1:8545

# NFTMarket 合约地址（部署后填写）
MARKET_ADDRESS=0x0000000000000000000000000000000000000000

# 链 ID：anvil = 31337，Sepolia = 11155111
CHAIN_ID=31337

# 启动时从哪个区块开始补历史事件：
#   latest  只监听启动之后产生的新事件
#   数字    例如 0 或 123456，会先补发该区块到最新区块之间的历史事件
FROM_BLOCK=latest

# 轮询间隔（毫秒），HTTP RPC 走轮询模式，越小越实时但请求越多
POLLING_INTERVAL_MS=4000

# 可选：强制指定支付代币精度（默认自动读取 token.decimals()）
# TOKEN_DECIMALS=18

# ===== demo 脚本使用（npm run demo） =====
# 卖家需持有支付代币（通常是部署 CalledToken 的账户）；买家不足时脚本会自动转账。
# anvil 默认账户私钥，仅限本地链使用，真实网络必须换成自己的且不要提交到仓库。
SELLER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BUYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# 上架单价（MTK）
DEMO_PRICE=100
# 每步交易之间的等待时间（毫秒）
DEMO_STEP_DELAY_MS=1500
