# 复制为 .env 后再修改

# ===== 基础 =====
# 节点 RPC 地址：anvil 默认 http://127.0.0.1:8545，Sepolia 换成自己的 RPC
RPC_URL=http://127.0.0.1:8545
# 链 ID：anvil = 31337，Sepolia = 11155111
CHAIN_ID=31337

# ===== TokenBank + CalledToken（npm run indexer / npm run transfer 使用） =====
# 先运行 TokenBankDemo 部署脚本，把终端打印的地址填到这里：
#   forge script script/TokenBankDemo.s.sol:TokenBankDemoScript --broadcast
TOKEN_ADDRESS=
BANK_ADDRESS=

# ===== ERC20 Transfer 索引服务（npm run indexer） =====
# SQLite 数据库文件
DB_PATH=./data/indexer.db
# 首次索引的起始区块；部署在区块 N 就填 N，填 0 会从头扫（anvil 重置后也能用）
INDEX_FROM_BLOCK=0
# 索引轮询间隔（毫秒）
INDEX_POLL_INTERVAL_MS=3000
# 单次 getLogs 最多扫描的区块数
INDEX_MAX_BLOCK_RANGE=2000
# 等待确认数，anvil 用 0
CONFIRMATIONS=0
# REST API + 前端页面端口
PORT=3000

# 可选：强制指定代币精度（默认自动读取 token.decimals()）
# TOKEN_DECIMALS=18

# ===== 账户互转模拟（npm run transfer） =====
# 默认用 anvil 助记词派生 #0 ~ #(N-1)，无需配置私钥。
# #0 通常是 CalledToken 部署者，持有 1,000,000 MTK，负责给其他账户充值。
# 参与转账的账户数量（最多 10 个，anvil 默认只给前 10 个账户发 ETH）
TRANSFER_ACCOUNT_COUNT=4
# 随机互转轮数
TRANSFER_ROUNDS=10
# 每笔转账金额（MTK）
TRANSFER_AMOUNT=10
# 给账户 #1 ~ #(N-1) 准备的初始余额目标（MTK），只补差额
TRANSFER_FUND_AMOUNT=100
# 每笔交易间隔（毫秒）
TRANSFER_DELAY_MS=1500
# 可选：anvil 启动时用了自定义助记词，在这里覆盖（不要加引号）
# ANVIL_MNEMONIC=test test test test test test test test test test test junk
# 可选：非 anvil 链或想完全自定义账户时，用逗号分隔私钥，顺序即 #0、#1……
# TRANSFER_PRIVATE_KEYS=0x...,0x...

# ===== Sepolia 命令行钱包（npm run wallet） =====
# Sepolia RPC；留空会使用公共节点 https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=
# 可选：覆盖默认代币地址 0x3ef32ca45D86cAbE1F0BEfc92f1F8E5788a4de40
# SEPOLIA_TOKEN_ADDRESS=
# 可选：账户文件路径，默认 ./data/cli-wallet.json（已 gitignore）
# CLI_WALLET_FILE=

# =====================================================================
# 可选：NFTMarket 监听 / 演示（与 TokenBank demo 无关，可整段忽略）
# =====================================================================
# MARKET_ADDRESS=
# FROM_BLOCK=latest
# POLLING_INTERVAL_MS=4000
# SELLER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# BUYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# DEMO_PRICE=100
# DEMO_STEP_DELAY_MS=1500
