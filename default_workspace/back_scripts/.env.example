# 复制为 .env 后再修改
# 节点 RPC 地址：anvil 默认 http://127.0.0.1:8545，Sepolia 换成自己的 RPC
RPC_URL=http://127.0.0.1:8545

# NFTMarket 合约地址（部署后填写）
MARKET_ADDRESS=0x0000000000000000000000000000000000000000

# 链 ID：anvil = 31337，Sepolia = 11155111
CHAIN_ID=31337

# 启动时从哪个区块开始补历史事件：
#   latest  只监听启动之后产生的新事件
#   数字    例如 0 或 123456，会先补发该区块到最新区块之间的历史事件
FROM_BLOCK=latest

# 轮询间隔（毫秒），HTTP RPC 走轮询模式，越小越实时但请求越多
POLLING_INTERVAL_MS=4000

# 可选：强制指定支付代币精度（默认自动读取 token.decimals()）
# TOKEN_DECIMALS=18

# ===== demo 脚本使用（npm run demo） =====
# 卖家需持有支付代币（通常是部署 CalledToken 的账户）；买家不足时脚本会自动转账。
# anvil 默认账户私钥，仅限本地链使用，真实网络必须换成自己的且不要提交到仓库。
SELLER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BUYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# 上架单价（MTK）
DEMO_PRICE=100
# 每步交易之间的等待时间（毫秒）
DEMO_STEP_DELAY_MS=1500

# ===== ERC20 转账索引服务（npm run indexer） =====
# 要索引的 CalledToken 地址（留空则从 MARKET_ADDRESS 的 token() 读取）
TOKEN_ADDRESS=
# SQLite 数据库文件
DB_PATH=./data/indexer.db
# 首次索引的起始区块；也可以填 latest（已有游标时忽略此项）
INDEX_FROM_BLOCK=0
# 索引轮询间隔（毫秒）
INDEX_POLL_INTERVAL_MS=3000
# 单次 getLogs 最多扫描的区块数
INDEX_MAX_BLOCK_RANGE=2000
# 等待确认数，anvil 用 0
CONFIRMATIONS=0
# REST API 端口
PORT=3000

# ===== 账户互转模拟（npm run transfer） =====
# 账户来源：默认用 anvil 助记词派生 #0 ~ #(N-1)，无需配置私钥。
# 其中 #0 负责给 #1 ~ #(N-1) 充值，所以它必须持有足够的 MTK
# （当前 anvil 上 #0 就是 CalledToken 部署者，持有 1,000,000 MTK）。
# 参与转账的账户数量（最多 10 个，anvil 默认只给前 10 个账户发 ETH）
TRANSFER_ACCOUNT_COUNT=4
# 随机互转轮数
TRANSFER_ROUNDS=10
# 每笔转账金额（MTK）
TRANSFER_AMOUNT=10
# 给账户 #1 ~ #(N-1) 准备的初始余额目标（MTK），只补差额
TRANSFER_FUND_AMOUNT=100
# 每笔交易间隔（毫秒）
TRANSFER_DELAY_MS=1500
# 可选：anvil 启动时用了自定义助记词，在这里覆盖（不要加引号）
# ANVIL_MNEMONIC=test test test test test test test test test test test junk
# 可选：非 anvil 链或想完全自定义账户时，用逗号分隔私钥，顺序即 #0、#1……
# TRANSFER_PRIVATE_KEYS=0x...,0x...
